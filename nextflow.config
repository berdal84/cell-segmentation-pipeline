
env {
    PYTHONUNBUFFERED = '1' // see https://docs.python.org/3/using/cmdline.html#cmdoption-u
}

conda {
    enabled = true
}

process {
    cpus     = 4
    memory   = 2.GB
    maxForks = 12

    conda    = "${projectDir}/environment.yml"
}

profiles {

    standard {
        process.executor = 'local'
    }

    hpc {
        process.executor = 'slurm'
    }
}