
env {
    PYTHONUNBUFFERED = '1' // see https://docs.python.org/3/using/cmdline.html#cmdoption-u
}

process {
    cpus        = 4
    memory      = 2.GB
    maxForks    = 12
    container   = "42borgata/data-science:0.1.0"

    withName: 'SEGMENTATION' {
        maxForks = 1
    }
}

profiles {
    standard {
        process.executor    = 'local'
        docker.enabled      = true
    }
}